#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

&mt {
    quick-tap-ms = <200>;
    require-prior-idle-ms = <125>;
    flavor = "tap-preferred";
};

/ {
    combos {
        compatible = "zmk,combos";

        sqt {
            bindings = <&kp SQT>;
            key-positions = <22 21>;
        };

        right-parenthesis {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <19 20>;
        };

        left-parenthesis {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <16 15>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <20 21>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <14 15>;
        };

        right-brace {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <33 34>;
        };

        left-brace {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <27 28>;
        };

        asterisk {
            bindings = <&kp ASTRK>;
            key-positions = <2 3>;
        };

        ampersand {
            bindings = <&kp AMPS>;
            key-positions = <3 4>;
        };

        exclamation {
            bindings = <&kp EXCL>;
            key-positions = <26 27>;
        };
    };

    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            label = "Home Row Mod Left";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-key-positions = <41 42 43 31 32 7 8 9 10 11 19 20 21 22 23 33 34 35 36 37 6 18>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            label = "Home Row Mod Right";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 30 38 39 40>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp ESC    &kp Q                &kp W            &kp E                &kp R              &kp T                          &kp Y  &kp U               &kp I                 &kp O             &kp P                    &kp BACKSPACE
&kp TAB    &hml LEFT_CONTROL A  &hml LEFT_ALT S  &hml LEFT_COMMAND D  &hml LEFT_SHIFT F  &kp G                          &kp H  &hmr RIGHT_SHIFT J  &hmr RIGHT_COMMAND K  &hmr RIGHT_ALT L  &hmr RIGHT_CONTROL SEMI  &kp SQT
&kp LSHFT  &kp Z                &kp X            &kp C                &kp V              &kp B  &kp LBKT     &kp RBKT   &kp N  &kp M               &kp COMMA             &kp DOT           &kp FSLH                 &kp RSHFT
                                                                      &kp LGUI           &mo 1  &kp SPACE    &kp ENTER  &mo 2  &kp LALT
            >;

            display-name = "Base";
        };

        nav {
            bindings = <
&trans  &kp N1     &kp N2     &kp N3      &kp N4     &kp N5                             &kp N6        &kp N7        &kp N8     &kp N9     &kp N0         &trans
&trans  &kp HOME   &kp INS    &kp DELETE  &kp END    &kp LG(SPACE)                      &trans        &kp LEFT      &kp DOWN   &kp UP     &kp RIGHT      &trans
&trans  &kp LG(Z)  &kp LG(X)  &kp LG(C)   &kp LG(V)  &kp PRINTSCREEN  &trans    &trans  &kp CAPSLOCK  &kp LA(LEFT)  &kp PG_DN  &kp PG_UP  &kp LA(RIGHT)  &trans
                                          &trans     &trans           &trans    &trans  &mo 3         &trans
            >;

            display-name = "Nav";
        };

        sym {
            bindings = <
&trans  &kp AT    &kp LT    &kp EQUAL  &kp GT    &kp GRAVE                    &kp CARET  &kp LBKT  &kp UNDER  &kp RBKT  &trans    &trans
&trans  &kp BSLH  &kp LPAR  &kp MINUS  &kp RPAR  &kp PLUS                     &kp PRCNT  &kp LBRC  &kp SEMI   &kp RBRC  &kp EXCL  &trans
&trans  &kp HASH  &kp STAR  &kp COLON  &kp FSLH  &trans     &trans    &trans  &trans     &kp PIPE  &kp TILDE  &kp AMPS  &kp DLLR  &trans
                                       &trans    &mo 3      &trans    &trans  &trans     &trans
            >;

            display-name = "Symbols";
        };

        adj {
            bindings = <
&bootloader  &trans  &kp F1  &kp F2   &kp F3   &kp F4                     &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2      &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR
&trans       &trans  &kp F5  &kp F6   &kp F7   &kp F8                     &out OUT_BLE  &kp C_VOL_DN  &kp C_MUTE        &kp C_VOL_UP  &trans        &studio_unlock
&trans       &trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans    &trans  &out OUT_USB  &kp C_PREV    &kp C_PLAY_PAUSE  &kp C_NEXT    &trans        &trans
                                      &trans   &trans   &trans    &trans  &trans        &trans
            >;

            display-name = "Adjust";
        };
    };
};
